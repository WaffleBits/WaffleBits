---
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.astro";
import { identity, serviceRecord, awards, certifications, education } from "../data/portfolio";
import { role, intro, openTo, measured, gates, limiterCode, limiterNote, measurement, index } from "../data/site";
import { asset } from "../lib/url";

const resume = asset("assets/AdnanBerik-Resume.pdf");
const usaf = serviceRecord[0];

/* The independent track is described here rather than pulled from the
   service record, so it does not repeat the projects above it. */
const independent = {
  span: "Ongoing",
  role: "Independent engineering",
  org: "Remote",
  lines: [
    "AI serving infrastructure: gateway, scheduler, GPU kernels, benchmarks.",
    "Linux game-server infrastructure for a community of about 29,000 players. Monitoring, backups, performance tuning.",
  ],
};

/* Data carries a double-colon separator that does not belong on the page. */
const split = (rows: string[]) => rows.flatMap((r) => r.split("::").map((s) => s.trim()));

/* Lua highlighting: strings first, so the keyword pass cannot rewrite the
   markup the string pass just produced. */
const esc = (s: string) => s.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
const KW = /\b(local|if|then|end|return|tonumber)\b/g;
const mark = (s: string) => esc(s).replace(KW, '<span class="kw">$1</span>');
const code = limiterCode
  .split("\n")
  .map((line) => {
    const re = /"[^"]*"/g;
    let out = "", at = 0, m: RegExpExecArray | null;
    while ((m = re.exec(line)) !== null) {
      out += mark(line.slice(at, m.index)) + `<span class="st">${esc(m[0])}</span>`;
      at = m.index + m[0].length;
    }
    return out + mark(line.slice(at));
  })
  .join("\n");
---

<Base>
  <Nav />

  <main id="top">
    <!-- ===================== HERO ===================== -->
    <section class="hero wrap">
      <div class="hero__grid">
        <div>
          <h1 class="name">{identity.name}</h1>
          <p class="hero__role">{role}</p>
          <p class="hero__intro">{intro}</p>
          <div class="hero__acts lks">
            <a class="lk" href="#work">Selected work</a>
            <a class="lk" href={identity.links.github} target="_blank" rel="noreferrer">GitHub</a>
            <a class="lk" href={resume} target="_blank" rel="noreferrer">Resume</a>
          </div>
        </div>
        <dl class="hero__side">
          <div><dt>Based</dt><dd>{identity.location}</dd></div>
          <div><dt>Open to</dt><dd>{openTo}</dd></div>
          <div><dt>Clearance</dt><dd>Active {identity.clearance}</dd></div>
        </dl>
      </div>
    </section>

    <!-- ===================== MEASURED ===================== -->
    <section class="mband" aria-label="Measured results">
      <div class="wrap">
        <div class="mband__in">
          {measured.map((m) => (
            <a class="mres" href={m.href} target="_blank" rel="noreferrer">
              <span class="mres__n">{m.n}<i>{m.unit}</i></span>
              <span class="mres__w">{m.what}</span>
              <span class="mres__h">{m.how}</span>
              <span class="mres__go">Method and raw data ↗</span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- ===================== WORK ===================== -->
    <section id="work" class="wrap bay">
      <div class="lead" data-in>
        <h2 class="h2">Selected work</h2>
        <span class="rule" aria-hidden="true"></span>
        <span class="aside">public on GitHub</span>
      </div>

      <!-- 1. gateway: architecture, request path, code -->
      <article class="proj" data-in>
        <div class="proj__top">
          <h3 class="h3">Secure GPU Inference Gateway</h3>
          <span class="proj__tag">Access control and audit</span>
          <p class="proj__line">
            An authenticated gateway in front of model endpoints. It decides who may call which model,
            at what budget, and what gets recorded.
          </p>
        </div>

        <div class="dgwrap">
        <svg class="dg" viewBox="0 0 900 236" role="img" aria-labelledby="dgt dgd">
          <title id="dgt">Gateway architecture</title>
          <desc id="dgd">A caller reaches the control plane, which applies identity, policy, budget and routing and writes an audit record, then forwards to the model servers while exporting metrics.</desc>
          <g class="dg-l">
            <path d="M96 93 H210" />
            <path d="M650 93 H760" />
            <path d="M430 190 V211 H760" />
          </g>
          <g class="dg-b">
            <rect x="0" y="76" width="96" height="34" />
            <rect x="210" y="30" width="440" height="160" class="hull" />
            <rect x="760" y="76" width="140" height="34" />
            <rect x="760" y="194" width="140" height="34" />
          </g>
          <g class="dg-n">
            <rect x="228" y="52" width="196" height="28" /><rect x="436" y="52" width="196" height="28" />
            <rect x="228" y="92" width="196" height="28" /><rect x="436" y="92" width="196" height="28" />
            <rect x="228" y="132" width="404" height="28" class="acc" />
          </g>
          <g class="dg-t">
            <text x="48" y="97" text-anchor="middle">CALLER</text>
            <text x="326" y="70" text-anchor="middle">IDENTITY</text>
            <text x="534" y="70" text-anchor="middle">POLICY</text>
            <text x="326" y="110" text-anchor="middle">BUDGET</text>
            <text x="534" y="110" text-anchor="middle">ROUTE</text>
            <text x="430" y="150" text-anchor="middle" class="on">AUDIT RECORD</text>
            <text x="830" y="97" text-anchor="middle">MODEL SERVERS</text>
            <text x="830" y="215" text-anchor="middle">METRICS</text>
          </g>
        </svg>
        </div>

        <div class="gates" id="gates">
          <span class="gmark" aria-hidden="true"></span>
          {gates.map(([n, name, detail]) => (
            <div class="gate"><b>{n}</b><strong>{name}</strong><span>{detail}</span></div>
          ))}
        </div>

        <div class="code">
          <pre><code set:html={code} /></pre>
          <div class="code__side">
            <span class="proj__tag">gateway/rate_limit.py, Redis path</span>
            <p>{limiterNote}</p>
          </div>
        </div>

        <div class="evid">
          <span class="proj__tag">{measurement.label}</span>
          <p>{measurement.body}</p>
          <div class="lks">
            <a class="lk" href={measurement.results} target="_blank" rel="noreferrer">Results ↗</a>
            <a class="lk" href={measurement.method} target="_blank" rel="noreferrer">Method ↗</a>
          </div>
        </div>

        <div class="proj__foot">
          <a class="lk" href="https://github.com/WaffleBits/secure-gpu-inference-gateway" target="_blank" rel="noreferrer">Repository ↗</a>
          <a class="lk" href="https://github.com/WaffleBits/secure-gpu-inference-gateway/blob/main/gateway/rate_limit.py" target="_blank" rel="noreferrer">rate_limit.py ↗</a>
          <span class="proj__stack">Python, FastAPI, Redis, OpenTelemetry, Docker</span>
        </div>
      </article>

      <!-- 2. kernels: the number is the layout -->
      <article class="proj" data-in>
        <div class="proj__top">
          <h3 class="h3">Triton Kernel Lab</h3>
          <span class="proj__tag">GPU performance</span>
          <p class="proj__line">Fused RMSNorm and autotuned SwiGLU kernels written in Triton.</p>
        </div>

        <div class="kern">
          <div>
            <span class="kern__n">2.2<i>×</i></span>
            <span class="kern__cap">RMSNorm · RTX 5070 Ti</span>
          </div>
          <div>
            <div class="bars">
              <div>
                <p class="bar__t"><span>torch.compile baseline</span><b>1.00×</b></p>
                <div class="bar__r"><span class="bar__f" style="--w:45%"></span></div>
              </div>
              <div class="bar--key">
                <p class="bar__t"><span>fused Triton kernel</span><b>up to 2.2×</b></p>
                <div class="bar__r"><span class="bar__f" style="--w:100%"></span></div>
              </div>
            </div>
            <p class="kern__note">
              Every output validated against an FP32 reference, cache flushed between runs.
              Full latency distributions and a regression gate are in the repository.
            </p>
          </div>
        </div>

        <div class="proj__foot">
          <a class="lk" href="https://github.com/WaffleBits/triton-kernel-lab" target="_blank" rel="noreferrer">Repository ↗</a>
          <a class="lk" href="https://github.com/WaffleBits/triton-kernel-lab#readme" target="_blank" rel="noreferrer">Measurements ↗</a>
          <span class="proj__stack">Triton, PyTorch, CUDA</span>
        </div>
      </article>

      <!-- 3. scheduler: the trace runs the full width -->
      <article class="proj" data-in>
        <div class="proj__top">
          <h3 class="h3">Deterministic Inference Scheduler</h3>
          <span class="proj__tag">Serving internals</span>
          <p class="proj__line">
            Continuous batching, paged KV-cache admission and decode scheduling rebuilt in Rust,
            so identical input produces an identical trace.
          </p>
        </div>

        <div class="trace">
          <div class="trace__r">
            <p class="trace__l">Run A, batch admission</p>
            <div class="trace__t" data-trace></div>
          </div>
          <div class="trace__r">
            <p class="trace__l">Run B, replayed from fingerprint</p>
            <div class="trace__t" data-trace></div>
          </div>
          <p class="trace__eq">Identical fingerprints, so a failing run replays exactly.</p>
        </div>

        <div class="proj__foot">
          <a class="lk" href="https://github.com/WaffleBits/deterministic-inference-scheduler" target="_blank" rel="noreferrer">Repository ↗</a>
          <span class="proj__stack">Rust</span>
        </div>
      </article>

      <!-- index -->
      <div class="lead" style="margin-top:clamp(40px,5vw,64px)" data-in>
        <h2 class="h2">Also public</h2>
        <span class="rule" aria-hidden="true"></span>
      </div>
      <div class="idx" data-in>
        {index.map((p) => (
          <a class="irow" href={p.href} target="_blank" rel="noreferrer">
            <span class="irow__t">{p.title}</span>
            <span class="irow__f">{p.fig}</span>
            <span class="irow__s">{p.stack}</span>
            <span class="irow__a" aria-hidden="true">↗</span>
            <span class="irow__l">{p.line}</span>
          </a>
        ))}
      </div>
    </section>

    <!-- ===================== EXPERIENCE ===================== -->
    <section id="experience" class="band">
      <div class="wrap bay">
        <div class="lead" data-in>
          <h2 class="h2">Experience</h2>
          <span class="rule" aria-hidden="true"></span>
        </div>

        <article class="job" data-in>
          <p class="job__w">{usaf.span}</p>
          <div>
            <h3 class="job__r">{usaf.role}</h3>
            <p class="job__o">{usaf.org}, {usaf.unit.replace(/\s*::\s*/g, ", ")}</p>
            <ul class="job__l">{usaf.lines.map((l) => <li>{l}</li>)}</ul>
          </div>
        </article>

        <article class="job" data-in>
          <p class="job__w">{independent.span}</p>
          <div>
            <h3 class="job__r">{independent.role}</h3>
            <p class="job__o">{independent.org}</p>
            <ul class="job__l">{independent.lines.map((l) => <li>{l}</li>)}</ul>
          </div>
        </article>

        <div class="creds" data-in>
          <div>
            <h3>Clearance and certification</h3>
            <ul>{split(certifications).map((c) => <li>{c}</li>)}</ul>
          </div>
          <div>
            <h3>Education</h3>
            <ul>{education.map((e) => {
              const [where, what] = e.split("::").map((x) => x.trim());
              return <li>{where}<em>{what}</em></li>;
            })}</ul>
          </div>
          <div>
            <h3>Recognition</h3>
            <ul>{awards.map((a) => <li>{a}</li>)}</ul>
          </div>
        </div>
      </div>
    </section>

    <!-- ===================== CONTACT ===================== -->
    <section id="contact" class="end">
      <div class="wrap bay">
        <div class="end__grid">
          <div data-in>
            <div class="lead" style="margin-bottom:26px">
              <h2 class="h2">Contact</h2>
              <span class="rule" aria-hidden="true"></span>
            </div>
            <a class="end__mail lk" href={`mailto:${identity.links.email}`}>{identity.links.email}</a>
            <div class="lks">
              <a class="lk" href={identity.links.linkedin} target="_blank" rel="noreferrer">LinkedIn</a>
              <a class="lk" href={identity.links.github} target="_blank" rel="noreferrer">GitHub</a>
              <a class="lk" href={resume} target="_blank" rel="noreferrer">Resume, PDF</a>
            </div>
          </div>
          <p class="end__note" data-in>
            Open to platform security and AI infrastructure roles in New York or Washington, D.C.
          </p>
        </div>
      </div>
    </section>
  </main>

  <footer class="foot">
    <div class="foot__in">
      <span>{identity.name}</span>
      <span>Hampton, Virginia</span>
      <a class="g" href="https://github.com/WaffleBits/WaffleBits" target="_blank" rel="noreferrer">Source of this page ↗</a>
    </div>
  </footer>
</Base>
