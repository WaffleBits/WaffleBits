---
import "../styles/global.css";
import { identity } from "../data/portfolio";
import { asset } from "../lib/url";
const title = `${identity.name} // Platform Security and AI Infrastructure`;
const desc =
  "Adnan Berik builds the control layer around AI model serving: access control, spending limits, deterministic scheduling, measured GPU kernels, and audit trails. US Air Force cyber defense, TS/SCI cleared.";

const person = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: identity.name,
  jobTitle: identity.role,
  email: `mailto:${identity.links.email}`,
  address: { "@type": "PostalAddress", addressLocality: "Hampton", addressRegion: "VA", addressCountry: "US" },
  url: "https://wafflebits.github.io/WaffleBits/",
  sameAs: [identity.links.linkedin, identity.links.github],
  knowsAbout: identity.domains,
};
---

<!doctype html>
<html lang="en" class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={desc} />
    <meta name="author" content={identity.name} />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#0a0a0b" />
    <meta property="og:type" content="profile" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={desc} />
    <meta property="og:image" content={asset("assets/avatar.jpg")} />
    <meta name="twitter:card" content="summary" />
    <link rel="icon" href={asset("assets/avatar.jpg")} type="image/jpeg" />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(person)} />
    <script is:inline>
      document.documentElement.classList.replace("no-js", "js");
    </script>
  </head>
  <body>
    <a class="skip" href="#top">Skip to content</a>
    <slot />
    <script>
      import "../lib/app";
    </script>
  </body>
</html>
