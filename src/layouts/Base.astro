---
import "../styles/global.css";
import { identity } from "../data/portfolio";
import { asset } from "../lib/url";
const site = "https://wafflebits.github.io/WaffleBits/";
const title = `${identity.name} · Platform security and AI infrastructure`;
const desc =
  "Adnan Berik. Cyber defense operations for the U.S. Air Force, TS/SCI cleared. Public work on AI serving infrastructure: access control and audit, deterministic scheduling, measured GPU kernels.";

const person = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: identity.name,
  jobTitle: "Cyber Defense Operations Specialist",
  email: `mailto:${identity.links.email}`,
  address: { "@type": "PostalAddress", addressLocality: "Hampton", addressRegion: "VA", addressCountry: "US" },
  url: site,
  sameAs: [identity.links.linkedin, identity.links.github],
  knowsAbout: identity.domains,
};
---

<!doctype html>
<html lang="en" class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={desc} />
    <meta name="author" content={identity.name} />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#0a0a0b" />
    <link rel="canonical" href={site} />
    <meta property="og:type" content="profile" />
    <meta property="og:url" content={site} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={desc} />
    <meta property="og:image" content={asset("assets/avatar.jpg")} />
    <meta name="twitter:card" content="summary" />
    <link rel="icon" href={asset("assets/avatar.jpg")} type="image/jpeg" />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(person)} />
    <script is:inline>
      document.documentElement.classList.replace("no-js", "js");
    </script>
  </head>
  <body>
    <a class="skip" href="#top">Skip to content</a>
    <slot />
    <script>
      import "../lib/app";
    </script>
  </body>
</html>
