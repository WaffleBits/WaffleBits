---
/* Command palette. Keyboard-first navigation for the people most likely
   to try Cmd-K on a portfolio, which is exactly the audience worth catching. */
---
<div class="pal" id="pal" role="dialog" aria-modal="true" aria-label="Command palette" hidden>
  <div class="pal__veil" data-pal-close></div>
  <div class="pal__box">
    <div class="pal__inp">
      <span class="car" aria-hidden="true">&gt;</span>
      <input id="pal-input" type="text" autocomplete="off" spellcheck="false"
             placeholder="Jump to a section, open a repository, copy an email" aria-label="Command" />
    </div>
    <ul class="pal__list" id="pal-list" role="listbox" aria-label="Commands"></ul>
    <p class="pal__hint"><span>↑↓ move</span><span>↵ run</span><span>esc close</span></p>
  </div>
</div>
