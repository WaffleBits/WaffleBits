---
/* Framed project media. The frame is instrument panel, not browser chrome:
   a label bar, the visual, and a provenance line saying where it came from. */
interface Props { cap: string; right?: string; foot?: string }
const { cap, right, foot } = Astro.props;
---
<figure class="media">
  <figcaption class="media__cap">
    <span>{cap}</span>
    {right && <span class="grow">{right}</span>}
  </figcaption>
  <div class="media__body"><slot /></div>
  {foot && <p class="media__foot">{foot}</p>}
</figure>
