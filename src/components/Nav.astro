---
import { identity } from "../data/portfolio";
const resume = `${import.meta.env.BASE_URL}assets/AdnanBerik-Resume.pdf`;
const links = [
  ["#work", "Work"],
  ["#system", "System"],
  ["#experience", "Experience"],
  ["#about", "About"],
  ["#contact", "Contact"],
];
---
<header class="nav">
  <div class="nav__in">
    <a class="nav__mark" href="#top" aria-label={`${identity.name}, back to top`}>
      <span class="dot" aria-hidden="true"></span>{identity.name}
    </a>
    <nav class="nav__links" aria-label="Sections">
      {links.map(([href, label]) => <a href={href} data-navlink={href.slice(1)}>{label}</a>)}
    </nav>
    <div class="nav__act">
      <a class="btn" href={resume} target="_blank" rel="noreferrer">Resume</a>
      <button class="nav__k" type="button" data-open-pal aria-haspopup="dialog" aria-controls="pal">
        <span aria-hidden="true">⌘</span>K
      </button>
    </div>
  </div>
  <div class="nav__bar" id="navbar" aria-hidden="true"></div>
</header>
